####
# Quarkus fast-jar image for Customer.WebApi.
#
# Builds the application inside the image with the same Gradle version the
# wrapper pins, on JDK 17, and runs it on a 17 JRE.
#
#   docker build -f src/Customer/Customer.WebApi/Dockerfile.fast-jar -t quicktest/customer.webapi .
#
###
FROM gradle:8.14.3-jdk17 AS build
ENV APP_HOME=/home/gradle/
WORKDIR $APP_HOME

COPY --chown=gradle:gradle build.gradle gradlew gradlew.bat settings.gradle gradle.properties $APP_HOME

COPY --chown=gradle:gradle ./src/SharedKernel $APP_HOME/src/SharedKernel
COPY --chown=gradle:gradle ./src/Customer $APP_HOME/src/Customer
COPY --chown=gradle:gradle ./src/Product/Product.Domain $APP_HOME/src/Product/Product.Domain

RUN gradle :Customer.WebApi:quarkusBuild --stacktrace --no-daemon

FROM eclipse-temurin:17-jre

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en'
ENV JAVA_OPTIONS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

WORKDIR /deployments
# Quarkus 2 packages fast-jar output under build/quarkus-app/.
COPY --from=build /home/gradle/src/Customer/Customer.WebApi/build/quarkus-app/ /deployments/

EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
