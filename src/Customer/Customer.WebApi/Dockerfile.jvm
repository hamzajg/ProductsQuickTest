####
# Quarkus application in JVM mode, on Java 17.
#
# Before building the image run `./gradlew build`; the image then packages the
# build output. See Dockerfile.fast-jar for the self-contained variant.
#
###
FROM registry.access.redhat.com/ubi8/openjdk-17:1.17

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en'
ENV JAVA_OPTIONS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

COPY --chown=185 build/lib/* /deployments/lib/
COPY --chown=185 build/*-runner.jar /deployments/app.jar

EXPOSE 8081
USER 185

ENTRYPOINT ["java", "-jar", "/deployments/app.jar"]
